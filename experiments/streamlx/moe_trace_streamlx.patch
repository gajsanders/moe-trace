+class StreamingQwen3MoeBlock(nn.Module):
+    """Qwen3 MoE block that forwards exact router scores to the stream pool.
+
+    The gate, top-k selection, score normalization, expert arithmetic, and
+    weighted sum match mlx_lm's Qwen3MoeSparseMoeBlock. Only expert storage
+    and eviction are delegated to StreamingSwitchGLU / StreamingSwitchMLP.
+    """
+
+    def __init__(self, original, pool: StreamingSwitchMLP):
+        super().__init__()
+        self.num_experts = original.num_experts
+        self.top_k = original.top_k
+        self.norm_topk_prob = original.norm_topk_prob
+        self.gate = original.gate
+        self.switch_mlp = StreamingSwitchGLU(pool)
+        self.sharding_group = getattr(original, "sharding_group", None)
+
+    def __call__(self, x: mx.array) -> mx.array:
+        if self.sharding_group is not None:
+            from mlx_lm.models.qwen3_moe import sum_gradients
+            x = sum_gradients(self.sharding_group)(x)
+
+        gates = self.gate(x)
+        gates = mx.softmax(gates, axis=-1, precise=True)
+
+        k = self.top_k
+        inds = mx.argpartition(gates, kth=-k, axis=-1)[..., -k:]
+        inds = mx.stop_gradient(inds)
+        scores = mx.take_along_axis(gates, inds, axis=-1)
+
+        if self.norm_topk_prob:
+            scores /= mx.sum(scores, axis=-1, keepdims=True)
+
+        y = self.switch_mlp(
+            x,
+            inds,
+            router_scores=scores,
+        )
+        y = (y * scores[..., None]).sum(axis=-2).astype(y.dtype)
+
+        if self.sharding_group is not None:
+            y = mx.distributed.all_sum(y, group=self.sharding_group)
+
+        return y
+
